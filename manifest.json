{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "0.3.1",
    "default_locale": "zh_TW",
    "description": "__MSG_extDescription__",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://play.riftatlas.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://riftbound.chroniclecore.com/*"
    ]
}
